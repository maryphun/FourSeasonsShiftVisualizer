{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "shift-visualize-ocr",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-04",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"secrets": {
		"required": [
			"GOOGLE_VISION_API_KEY"
		]
	},
	"d1_databases": [
		{
			"binding": "REMINDER_DB",
			"database_name": "schedule-photo-reader-reminders",
			"database_id": "02afa78e-d7ec-425d-85c0-eb5509dac5b4",
			"migrations_dir": "./migrations"
		}
	]
}
